{
  "name": "@dealpilot/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "dev:cloud": "cross-env DEALPILOT_WORKBENCH_ORIGIN=http://127.0.0.1:5173 DEALPILOT_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173 DEALPILOT_SKIP_TRAY=1 DEALPILOT_SKIP_NM_REGISTRATION=1 bun --hot src/index.ts",
    "build": "bun build --compile --target=bun-windows-x64 src/index.ts --outfile dist/dealpilot-agent.exe",
    "start": "bun src/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun src/db/migrate.ts",
    "type-check": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@dealpilot/shared": "workspace:*",
    "@hono/zod-validator": "^0.4.0",
    "drizzle-orm": "^0.33.0",
    "hash-wasm": "^4.12.0",
    "hono": "^4.6.0",
    "node-notifier": "^10.0.1",
    "papaparse": "^5.4.1",
    "xlsx": "^0.18.5",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node-notifier": "^8.0.5",
    "@types/papaparse": "^5.3.14",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.24.0",
    "typescript": "^5.5.0"
  }
}
