{
  "name": "dealpilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "test": "turbo test",
    "test:e2e": "cross-env PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers playwright test",
    "test:e2e:install": "cross-env PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers playwright install chromium",
    "playwright:cli": "cross-env PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers playwright-cli",
    "migration:v1": "pnpm --filter @dealpilot/migration extract",
    "audit:retirement": "node scripts/check-v1-retirement.mjs",
    "audit:v2": "node scripts/audit-v2-production.mjs",
    "test:audit:v2": "node --test scripts/audit-v2-production.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@playwright/cli": "0.1.17",
    "@playwright/test": "1.62.0",
    "cross-env": "10.1.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.4.0",
    "turbo": "latest",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.46.0"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "pnpm": {
    "packageExtensions": {
      "@tanstack/react-query": {
        "peerDependencies": {
          "@types/react": "^18 || ^19"
        }
      },
      "@tanstack/react-router": {
        "peerDependencies": {
          "@types/react": "^18 || ^19"
        }
      },
      "@tanstack/react-table": {
        "peerDependencies": {
          "@types/react": "^18 || ^19"
        }
      },
      "lucide-react": {
        "peerDependencies": {
          "@types/react": "^18 || ^19"
        }
      },
      "react-hook-form": {
        "peerDependencies": {
          "@types/react": "^18 || ^19"
        }
      }
    }
  }
}
