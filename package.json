{
  "name": "dealpilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "test": "turbo test",
    "test:e2e": "cross-env PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers playwright test",
    "test:e2e:install": "cross-env PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers playwright install chromium",
    "playwright:cli": "cross-env PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers playwright-cli"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/cli": "0.1.17",
    "@playwright/test": "1.62.0",
    "cross-env": "10.1.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.4.0",
    "turbo": "latest",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.46.0"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
